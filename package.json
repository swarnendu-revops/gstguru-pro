{
  "name": "gstguru-pro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "preview": "node scripts/serve-static.mjs",
    "typecheck": "next typegen && tsc --noEmit",
